# ============================================================
# LOCAL MODE - Docker Compose variable substitution
# Loaded by local.sh via: docker compose --env-file .env.local
# These vars are interpolated into docker-compose.local.yml.
# ============================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# MinIO (S3-compatible object storage)
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Frontend - URL reachable from the browser (points to nginx). Must match
# the VITE_API_GATEWAY name the frontend code actually reads
# (src/api/gatewayApi.ts) — a prior FRONTEND_API_BASE/VITE_API_BASE naming
# mismatch left this silently unused, so the local frontend build fell back
# to its http://localhost:8082 default (the dev stack's gateway) instead.
FRONTEND_API_GATEWAY=http://localhost:9082/api/v1
