ENV=development
TZ=UTC

# RabbitMQ broker — localhost because worker runs on host in dev mode
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Redis result backend
REDIS_URL=redis://localhost:6379/0

# AI database — used by cleanup_sessions task
AI_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grandflow_ai

# Which transactional-email client the worker instantiates: "mailersend",
# "mailjet", "brevo", or "console" (prints the send instead of calling a real
# API — no network/credentials needed, see shared/services/console_email_client.py).
# Set to console here since Mailjet blocks sends from this dev IP; switch to
# mailjet/mailersend/brevo to test the real HTTP call path.
EMAIL_PROVIDER=console

# MailerSend Email API — trial domain in dev, capped at 100 sends and only
# delivers to recipient addresses verified on the account.
MAILERSEND_API_TOKEN=
MAILERSEND_SENDER_DOMAIN=opengrantflow.com
MAILERSEND_SENDER_EMAIL=hello@opengrantflow.com
MAILERSEND_SENDER_NAME=OpenGrandFlow
MAILERSEND_VERIFICATION_TEMPLATE_ID=3z0vklo5x9747qrx
# Admin-invite email template — separate from verification (welcomes the
# invitee, names the inviter/company, links to /accept-invite). Create this
# template on the MailerSend dashboard and set its ID here; invite sends
# will fail until this is set.
MAILERSEND_INVITE_TEMPLATE_ID=
# Password-reset email template — create this on the MailerSend dashboard
# and set its ID here; reset sends will fail until this is set.
MAILERSEND_PASSWORD_RESET_TEMPLATE_ID=
# Leave blank to use the real MailerSend API. Only set this to redirect
# sends at a local mock server instead.
MAILERSEND_API_URL=

# Mailjet Send API — key+secret Basic Auth (not a bearer token).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=hello@opengrantflow.com
MAILJET_SENDER_NAME=OpenGrandFlow
MAILJET_VERIFICATION_TEMPLATE_ID=8258185
# Admin-invite email template — see MAILERSEND_INVITE_TEMPLATE_ID above.
MAILJET_INVITE_TEMPLATE_ID=8276997
# Password-reset email template — see MAILERSEND_PASSWORD_RESET_TEMPLATE_ID above.
MAILJET_PASSWORD_RESET_TEMPLATE_ID=8308227
# Leave blank to use the real Mailjet API. Only set this to redirect sends at
# a local mock server instead.
MAILJET_API_URL=

# Brevo transactional email API — single api-key header (no separate secret).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@opengrantflow.com
BREVO_SENDER_NAME=OpenGrandFlow
# Dashboard template IDs — see MAILERSEND_*_TEMPLATE_ID above for what each covers.
BREVO_VERIFICATION_TEMPLATE_ID=1
BREVO_INVITE_TEMPLATE_ID=2
BREVO_PASSWORD_RESET_TEMPLATE_ID=3
# Leave blank to use the real Brevo API. Only set this to redirect sends at a
# local mock server instead.
BREVO_API_URL=

# Origin the verification link points at
FRONTEND_BASE_URL=http://localhost:3001

# Grafana Cloud OTLP gateway vars — intentionally unset here, matching the
# other services' dev defaults. shared/observability falls back to the local
# OTel Collector at localhost:4318 (reachable since the worker runs on the
# host in dev mode), same as it would if OTEL_EXPORTER_OTLP_ENDPOINT were
# explicitly set to that address.
