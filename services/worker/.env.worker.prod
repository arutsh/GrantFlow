ENV=production
TZ=UTC

# RabbitMQ broker — Docker service name in prod, composed from the same
# RABBITMQ_USER/RABBITMQ_PASS secrets the broker itself is configured with.
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672/

# Redis result backend
REDIS_URL=redis://redis:6379/0

# AI database — used by cleanup_sessions task
AI_DATABASE_URL=${AI_DATABASE_URL}

# Which transactional-email client the worker instantiates: "mailersend",
# "mailjet", or "brevo". Flipping this is a config-only change (no PR needed),
# see docs/deployment/DEPLOYMENT_MODES.md.
EMAIL_PROVIDER=brevo

# MailerSend Email API — verified sending domain in production
MAILERSEND_API_TOKEN=${MAILERSEND_API_TOKEN}
MAILERSEND_SENDER_DOMAIN=${MAILERSEND_SENDER_DOMAIN}
MAILERSEND_SENDER_EMAIL=${MAILERSEND_SENDER_EMAIL}
MAILERSEND_SENDER_NAME=OpenGrandFlow
# Not a secret (just a template identifier) — hardcoded rather than routed
# through deploy.yml's secret substitution like the vars above.
MAILERSEND_VERIFICATION_TEMPLATE_ID=3z0vklo5x9747qrx
# Admin-invite email template — separate from verification (welcomes the
# invitee, names the inviter/company, links to /accept-invite). Blank until
# the template is created on the MailerSend dashboard; invite sends fail
# until this is set.
MAILERSEND_INVITE_TEMPLATE_ID=
# Password-reset email template. Blank until the template is created on the
# MailerSend dashboard; reset sends fail until this is set.
MAILERSEND_PASSWORD_RESET_TEMPLATE_ID=

# Mailjet Send API — key+secret Basic Auth (not a bearer token). Plumbed
# ahead of time so flipping EMAIL_PROVIDER to mailjet in prod later needs no
# code change, only these secrets set and EMAIL_PROVIDER updated above.
MAILJET_API_KEY=${MAILJET_API_KEY}
MAILJET_SECRET_KEY=${MAILJET_SECRET_KEY}
MAILJET_SENDER_EMAIL=${MAILJET_SENDER_EMAIL}
MAILJET_SENDER_NAME=OpenGrandFlow
# Not a secret (just a template identifier) — hardcoded rather than routed
# through deploy.yml's secret substitution like the vars above.
MAILJET_VERIFICATION_TEMPLATE_ID=8258185
# Admin-invite email template — see MAILERSEND_INVITE_TEMPLATE_ID above.
MAILJET_INVITE_TEMPLATE_ID=8276997
# Password-reset email template — see MAILERSEND_PASSWORD_RESET_TEMPLATE_ID above.
MAILJET_PASSWORD_RESET_TEMPLATE_ID=8308227

# Brevo transactional email API — plumbed ahead of time so flipping
# EMAIL_PROVIDER to brevo later needs no code change.
BREVO_API_KEY=${BREVO_API_KEY}
BREVO_SENDER_EMAIL=${BREVO_SENDER_EMAIL}
BREVO_SENDER_NAME=OpenGrandFlow
# Blank until templates are created on the Brevo dashboard; sends fail until set.
BREVO_VERIFICATION_TEMPLATE_ID=1
BREVO_INVITE_TEMPLATE_ID=2
BREVO_PASSWORD_RESET_TEMPLATE_ID=3

# Origin the verification link points at
FRONTEND_BASE_URL=${FRONTEND_BASE_URL}

# Slack Incoming Webhook for outbound notifications (e.g. bug reports).
# Blank uses the console fallback (logs instead of sending); fill in out of
# band on the prod host, not wired through deploy.yml's secret substitution.
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}

# Object storage (S3-compatible) — used to generate a presigned link for a
# bug report's screenshot attachment. Same bucket/credentials as budget.
STORAGE_ENDPOINT_URL=${STORAGE_ENDPOINT_URL}
STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY}
STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY}
STORAGE_BUCKET_NAME=open-grantflow-reports

# Grafana Cloud OTLP gateway — see docs/observability/GRAFANA_CLOUD_PRODUCTION.md.
# Same endpoint/credentials the four FastAPI services already use.
OTEL_EXPORTER_OTLP_ENDPOINT=${GRAFANA_CLOUD_OTLP_ENDPOINT}
OTEL_EXPORTER_OTLP_HEADERS=${GRAFANA_CLOUD_OTLP_HEADERS}
# Kill switch: set to "true" and redeploy to fully disable worker telemetry
# export without a code change. Blank (default) leaves it enabled.
OTEL_SDK_DISABLED=
