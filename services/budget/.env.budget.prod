ENV=production
DEBUG=False
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_HOST=grandflow-db
POSTGRES_PORT=5432
POSTGRES_DB_NAME=grandflow_budget
BUDGET_DATABASE_URL=${BUDGET_DATABASE_URL}
REDIS_URL=redis://redis:6379/0
STORAGE_ENDPOINT_URL=${STORAGE_ENDPOINT_URL}
STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY}
STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY}
STORAGE_BUCKET_NAME=open-grantflow-reports
USER_ALL_SERVICES_URL=http://users:8000/api/
CUSTOMER_SERVICE_URL=${USER_ALL_SERVICES_URL}customers/
DONOR_GRANTEE_SERVICE_URL=${USER_ALL_SERVICES_URL}donor-grantees/
USER_SERVICE_URL=${USER_ALL_SERVICES_URL}users/
RULE_BASED_MAPPING_ENABLED=False
USE_SEMANTIC_EMBEDDINGS=True
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672/
RABBITMQ_EXCHANGE=grandflow.events
RABBITMQ_QUEUE=user_events.budget_service
LOG_LEVEL=INFO
# Must match the users service's JWT_SECRET_KEY exactly — tokens are issued by
# users and verified here.
JWT_SECRET_KEY=${JWT_SECRET_KEY}
# Grafana Cloud OTLP gateway — shared/observability falls back to insecure
# localhost:4318 if these are unset, so this is safe to leave blank locally.
OTEL_EXPORTER_OTLP_ENDPOINT=${GRAFANA_CLOUD_OTLP_ENDPOINT}
OTEL_EXPORTER_OTLP_HEADERS=${GRAFANA_CLOUD_OTLP_HEADERS}
